# Recommended for most uses (Neon Pooler)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?channel_binding=require&sslmode=require"

# Direct URL for Prisma migrations (without pgbouncer)
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"

# Parameters for constructing your own connection string
PGHOST="ep-sample-pooler.region.aws.neon.tech"
PGHOST_UNPOOLED="ep-sample.region.aws.neon.tech"
PGUSER="neondb_owner"
PGDATABASE="neondb"
PGPASSWORD="your_password"

# JWT Secret for authentication sessions
JWT_SECRET="generate-a-secure-random-jwt-secret"
